---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import EmergencyBand from '../../components/sections/EmergencyBand.astro';
import { siteConfig } from '../../data/site.js';
import { url } from '../../utils/url.js';
import { generateBreadcrumbSchema } from '../../utils/seo.js';

const breadcrumbs = [
  { name: 'Zones', url: '/zones' },
  { name: 'Paris & Île-de-France' }
];

const areas = [
  { name: 'Paris intra-muros', desc: 'Tous arrondissements' },
  { name: 'Hauts-de-Seine (92)', desc: 'Boulogne, Neuilly, Nanterre...' },
  { name: 'Seine-Saint-Denis (93)', desc: 'Montreuil, Saint-Denis...' },
  { name: 'Val-de-Marne (94)', desc: 'Créteil, Vincennes...' },
  { name: 'Val-d\'Oise (95)', desc: 'Cergy, Argenteuil...' },
  { name: 'Seine-et-Marne (77)', desc: 'Meaux, Melun...' }
];

const services = [
  { name: 'Bricolage', icon: 'tool', desc: 'Petits travaux, réparations' },
  { name: 'Montage meubles', icon: 'box', desc: 'IKEA, Conforama, etc.' },
  { name: 'Électricité', icon: 'zap', desc: 'Dépannage, installation' },
  { name: 'Maintenance', icon: 'settings', desc: 'Entretien régulier' }
];

const digitalServices = [
  { name: 'Création site web', icon: 'globe', desc: 'Vitrine, e-commerce' },
  { name: 'SEO & Google Ads', icon: 'trending-up', desc: 'Visibilité en ligne' }
];

const localSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "W4S - Services Paris & Île-de-France",
  "description": "Services à domicile et digitaux à Paris et en Île-de-France. Bricolage, montage meubles, création sites web, SEO. Devis gratuit.",
  "url": `${siteConfig.url}/zones/paris`,
  "telephone": siteConfig.contact.phoneFormatted,
  "email": siteConfig.contact.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.contact.address.street,
    "addressLocality": siteConfig.contact.address.city,
    "postalCode": siteConfig.contact.address.postalCode,
    "addressRegion": "Île-de-France",
    "addressCountry": "FR"
  },
  "areaServed": {
    "@type": "State",
    "name": "Île-de-France"
  },
  "priceRange": "€€"
};
---

<BaseLayout
  title="Services à Paris & Île-de-France"
  description="W4S à Paris : bricolage, montage meubles, électricité + création sites web et SEO. Interventions ponctuelles, services digitaux disponibles partout. Devis gratuit."
  canonical="/zones/paris"
  jsonLd={[localSchema, generateBreadcrumbSchema(breadcrumbs)]}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-w4s-concrete/30 via-white to-white py-16 md:py-24">
    <div class="absolute inset-0 overflow-hidden -z-10" aria-hidden="true">
      <div class="gradient-orb gradient-orb-1"></div>
      <div class="gradient-orb gradient-orb-2"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(10,26,47,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(10,26,47,0.03)_1px,transparent_1px)] bg-[size:60px_60px]"></div>
    </div>

    <div class="container-w4s relative z-10">
      <Breadcrumb items={breadcrumbs} />

      <div class="max-w-4xl mx-auto text-center">
        <div class="scroll-animate inline-flex items-center gap-2 px-5 py-2.5 glass rounded-full text-small font-medium mb-8 shadow-lg">
          <Icon name="globe" size={16} class="text-w4s-accent" />
          <span class="text-w4s-navy">Services digitaux disponibles partout</span>
        </div>

        <h1 class="scroll-animate stagger-1 text-4xl sm:text-5xl md:text-6xl font-bold text-w4s-navy mb-6 text-balance leading-tight">
          Services à domicile
          <span class="block mt-2">
            <span class="gradient-text-animated">Paris & Île-de-France</span>
          </span>
        </h1>

        <p class="scroll-animate stagger-2 text-body-lg text-w4s-navy/70 mb-8 max-w-2xl mx-auto">
          Interventions ponctuelles pour bricolage et électricité. Services digitaux (création de sites, SEO) disponibles en permanence.
        </p>

        <!-- Stats -->
        <div class="scroll-animate stagger-3 grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
          <div class="bg-white/80 rounded-xl p-4 shadow-card">
            <div class="text-2xl md:text-3xl font-bold text-w4s-accent">IDF</div>
            <div class="text-small text-w4s-navy/70">Zone couverte</div>
          </div>
          <div class="bg-white/80 rounded-xl p-4 shadow-card">
            <div class="text-2xl md:text-3xl font-bold text-w4s-success">RDV</div>
            <div class="text-small text-w4s-navy/70">Sur rendez-vous</div>
          </div>
          <div class="bg-white/80 rounded-xl p-4 shadow-card">
            <div class="text-2xl md:text-3xl font-bold text-w4s-accent">Digital</div>
            <div class="text-small text-w4s-navy/70">France entière</div>
          </div>
          <div class="bg-white/80 rounded-xl p-4 shadow-card">
            <div class="text-2xl md:text-3xl font-bold text-w4s-navy">Pro</div>
            <div class="text-small text-w4s-navy/70">Qualité garantie</div>
          </div>
        </div>

        <!-- CTAs -->
        <div class="scroll-animate stagger-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={url('/contact')}
            class="group relative inline-flex items-center gap-2 px-8 py-4 bg-w4s-accent text-white font-semibold rounded-xl btn-shimmer btn-glow transition-all duration-300 hover:scale-105"
          >
            <span>Demander un devis</span>
            <Icon name="arrow-right" size={20} class="transition-transform group-hover:translate-x-1" />
          </a>
          <a
            href={`tel:${siteConfig.contact.phoneFormatted}`}
            class="group relative inline-flex items-center gap-2 px-8 py-4 bg-white border-2 border-w4s-navy text-w4s-navy font-semibold rounded-xl transition-all duration-300 hover:bg-w4s-navy hover:text-white"
          >
            <Icon name="phone" size={20} />
            <span>{siteConfig.contact.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Info Banner -->
  <section class="bg-w4s-accent/10 py-8">
    <div class="container-w4s">
      <div class="flex flex-col md:flex-row items-center justify-center gap-6 text-center md:text-left">
        <div class="flex items-center gap-3">
          <Icon name="info" size={24} class="text-w4s-accent" />
          <p class="text-body text-w4s-navy">
            <strong>Note :</strong> Les interventions à domicile à Paris sont ponctuelles. Pour les services digitaux, nous travaillons à distance avec des clients de toute la France.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Digital Services Section -->
  <section class="section bg-white">
    <div class="container-w4s">
      <div class="text-center mb-12">
        <div class="scroll-animate inline-flex items-center gap-2 px-4 py-2 bg-w4s-success/10 rounded-full text-small font-medium text-w4s-success mb-4">
          <Icon name="check" size={14} />
          Disponible partout en France
        </div>
        <h2 class="scroll-animate text-h2 font-bold text-w4s-navy mb-4">Services digitaux</h2>
        <p class="scroll-animate stagger-1 text-body-lg text-w4s-navy/70 max-w-2xl mx-auto">
          Création de sites web et référencement SEO/ADS. Travail à distance, résultats concrets.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {digitalServices.map((service, i) => (
          <div class={`scroll-animate stagger-${i + 1} bg-gradient-to-br from-w4s-accent/5 to-w4s-accent/10 rounded-2xl p-8 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl`}>
            <div class="w-16 h-16 bg-w4s-accent rounded-xl flex items-center justify-center mb-6">
              <Icon name={service.icon} size={32} class="text-white" />
            </div>
            <h3 class="text-h3 font-semibold text-w4s-navy mb-3">{service.name}</h3>
            <p class="text-body text-w4s-navy/70 mb-6">{service.desc}</p>
            <a
              href={url(`/services/${service.name === 'Création site web' ? 'creation-site-web' : 'seo-ads'}`)}
              class="inline-flex items-center gap-2 text-w4s-accent font-semibold hover:gap-3 transition-all"
            >
              En savoir plus
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Physical Services Section -->
  <section class="section bg-w4s-concrete/10">
    <div class="container-w4s">
      <div class="text-center mb-12">
        <div class="scroll-animate inline-flex items-center gap-2 px-4 py-2 bg-w4s-warning/10 rounded-full text-small font-medium text-w4s-warning mb-4">
          <Icon name="calendar" size={14} />
          Sur rendez-vous uniquement
        </div>
        <h2 class="scroll-animate text-h2 font-bold text-w4s-navy mb-4">Services à domicile</h2>
        <p class="scroll-animate stagger-1 text-body-lg text-w4s-navy/70 max-w-2xl mx-auto">
          Interventions ponctuelles sur rendez-vous dans Paris et la proche banlieue.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((service, i) => (
          <div class={`scroll-animate stagger-${i + 1} bg-white rounded-2xl shadow-card hover:shadow-card-hover p-6 transition-all duration-300 hover:-translate-y-2`}>
            <div class="w-14 h-14 bg-w4s-navy/10 rounded-xl flex items-center justify-center mb-4">
              <Icon name={service.icon} size={28} class="text-w4s-navy" />
            </div>
            <h3 class="text-h4 font-semibold text-w4s-navy mb-2">{service.name}</h3>
            <p class="text-body text-w4s-navy/70">{service.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Areas Section -->
  <section class="section bg-white">
    <div class="container-w4s">
      <div class="text-center mb-12">
        <h2 class="scroll-animate text-h2 font-bold text-w4s-navy mb-4">Zones couvertes en Île-de-France</h2>
        <p class="scroll-animate stagger-1 text-body-lg text-w4s-navy/70 max-w-2xl mx-auto">
          Interventions possibles sur rendez-vous dans ces zones.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {areas.map((area, i) => (
          <div class={`scroll-animate stagger-${(i % 3) + 1} bg-w4s-concrete/10 rounded-xl p-5 transition-all duration-300 hover:bg-w4s-concrete/20`}>
            <div class="flex items-start gap-3">
              <Icon name="map-pin" size={20} class="text-w4s-accent mt-0.5 flex-shrink-0" />
              <div>
                <div class="font-semibold text-w4s-navy">{area.name}</div>
                <div class="text-small text-w4s-navy/70">{area.desc}</div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="scroll-animate mt-8 p-6 bg-w4s-accent/5 rounded-2xl text-center">
        <p class="text-body text-w4s-navy/70 mb-4">
          <strong>Frais de déplacement :</strong> Un supplément peut s'appliquer selon la distance depuis notre base dans l'Oise.
        </p>
        <Button variant="outline" href={url('/contact')}>
          Demander un devis personnalisé
          <Icon name="arrow-right" size={18} />
        </Button>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="section bg-w4s-concrete/10">
    <div class="container-w4s">
      <div class="bg-w4s-navy rounded-3xl overflow-hidden">
        <div class="grid md:grid-cols-2 items-center">
          <div class="p-8 md:p-12 text-white">
            <h2 class="scroll-animate text-h2 font-bold mb-4">Paris & Île-de-France</h2>
            <p class="scroll-animate stagger-1 text-body-lg text-white/80 mb-6">
              Nous intervenons ponctuellement dans la région parisienne pour les services à domicile. Pour le digital, nous travaillons avec des clients de toute la France.
            </p>
            <ul class="scroll-animate stagger-2 space-y-3 mb-8">
              <li class="flex items-center gap-3">
                <Icon name="check-circle" size={20} class="text-w4s-success" />
                <span>Interventions sur rendez-vous</span>
              </li>
              <li class="flex items-center gap-3">
                <Icon name="check-circle" size={20} class="text-w4s-success" />
                <span>Services digitaux à distance</span>
              </li>
              <li class="flex items-center gap-3">
                <Icon name="check-circle" size={20} class="text-w4s-success" />
                <span>Devis gratuit et sans engagement</span>
              </li>
            </ul>
            <div class="scroll-animate stagger-3">
              <a
                href={url('/contact')}
                class="inline-flex items-center gap-2 px-6 py-3 bg-w4s-accent text-white font-semibold rounded-xl transition-all duration-300 hover:bg-w4s-accent-hover"
              >
                Nous contacter
                <Icon name="arrow-right" size={18} />
              </a>
            </div>
          </div>
          <div class="h-64 md:h-full min-h-[300px]">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d336476.0!2d2.2!3d48.86!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66e1f06e2b70f%3A0x40b82c3688c9460!2sParis!5e0!3m2!1sfr!2sfr!4v1704067200000!5m2!1sfr!2sfr"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Carte de Paris - Zone d'intervention W4S"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-gradient-to-r from-w4s-accent to-w4s-accent/90 text-white">
    <div class="container-w4s text-center">
      <h2 class="scroll-animate text-h2 font-bold mb-4">Un projet à Paris ou en Île-de-France ?</h2>
      <p class="scroll-animate stagger-1 text-body-lg text-white/80 mb-8 max-w-2xl mx-auto">
        Contactez-nous pour discuter de votre besoin. Devis gratuit et personnalisé.
      </p>
      <div class="scroll-animate stagger-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={url('/contact')}
          class="group inline-flex items-center gap-2 px-8 py-4 bg-white text-w4s-accent font-semibold rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl"
        >
          <span>Demander un devis</span>
          <Icon name="arrow-right" size={20} class="transition-transform group-hover:translate-x-1" />
        </a>
        <a
          href={`tel:${siteConfig.contact.phoneFormatted}`}
          class="inline-flex items-center gap-2 px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-xl transition-all duration-300 hover:bg-white hover:text-w4s-accent"
        >
          <Icon name="phone" size={20} />
          <span>{siteConfig.contact.phone}</span>
        </a>
      </div>
    </div>
  </section>

  <EmergencyBand />
</BaseLayout>
